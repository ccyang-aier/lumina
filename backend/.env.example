# ===========================================
# Lumina Backend Environment Configuration
# Copy this file to .env and update values
# ===========================================

# Application Settings
APP_NAME=Lumina
APP_VERSION=1.0.0
APP_DEBUG=true
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=lumina
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
